{
  "compilerOptions": {
    "target": "ES2022",
    "outDir": "./dist/legacy",
    "rootDir": "./src/legacy",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "preserveConstEnums": true
  },
  "include": [
    "src/legacy/types.d.ts",
    "src/legacy/config.ts",
    "src/legacy/constants.ts",
    "src/legacy/i18n.ts",
    "src/legacy/prefs.ts"
  ]
}
